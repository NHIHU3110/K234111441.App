<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7E8"
    android:orientation="vertical"
    android:padding="18dp"
    tools:context=".CalculatorActivity">

    <!-- Header vui tươi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginBottom="14dp"
        android:background="#FFB703"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:backgroundTint="#FFFFFF"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="26dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_back_arrow"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="#3A2E00" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toán học vui vẻ"
                android:textColor="#3A2E00"
                android:textSize="27sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Ô hiển thị -->
    <EditText
        android:id="@+id/editFomula"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="end|center_vertical"
        android:hint="0"
        android:inputType="text"
        android:padding="22dp"
        android:textColor="#264653"
        android:textColorHint="#9AA7A8"
        android:textSize="42sp"
        android:textStyle="bold" />

    <!-- Memory buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtMC"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#FFE8A3"
            android:elevation="3dp"
            android:gravity="center"
            android:text="@string/str_mc"
            android:textColor="#805B00"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMR"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#D7F9F1"
            android:elevation="3dp"
            android:gravity="center"
            android:text="@string/str_mr"
            android:textColor="#00796B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMplus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#FFE1EC"
            android:elevation="3dp"
            android:gravity="center"
            android:text="@string/str_mplus"
            android:textColor="#C2185B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMminus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#E5E0FF"
            android:elevation="3dp"
            android:gravity="center"
            android:text="@string/str_mminus"
            android:textColor="#5E35B1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMS"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#DFF7C8"
            android:elevation="3dp"
            android:gravity="center"
            android:text="@string/str_ms"
            android:textColor="#558B2F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtM"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#FFD6D6"
            android:elevation="3dp"
            android:gravity="center"
            android:text="@string/str_m"
            android:textColor="#D84315"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bàn phím màu sắc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnpercent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#8ECAE6"
                android:elevation="5dp"
                android:text="%"
                android:textColor="#023047"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnCE"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#8ECAE6"
                android:elevation="5dp"
                android:text="CE"
                android:textColor="#023047"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FF758F"
                android:elevation="5dp"
                android:text="C"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FF758F"
                android:elevation="5dp"
                android:text="⌫"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn1_x"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#BDE0FE"
                android:elevation="5dp"
                android:text="1/x"
                android:textColor="#1D3557"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnx_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#BDE0FE"
                android:elevation="5dp"
                android:text="x²"
                android:textColor="#1D3557"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn_square_x"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#BDE0FE"
                android:elevation="5dp"
                android:text="√x"
                android:textColor="#1D3557"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FB8500"
                android:elevation="6dp"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="7"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="8"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="9"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FB8500"
                android:elevation="6dp"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="4"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="5"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="6"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FB8500"
                android:elevation="6dp"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="1"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="2"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="3"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FB8500"
                android:elevation="6dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnplus_minus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#CDB4DB"
                android:elevation="5dp"
                android:text="+/−"
                android:textColor="#3C096C"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="5dp"
                android:text="0"
                android:textColor="#264653"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:onClick="processInputData"
                android:id="@+id/btnDot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#CDB4DB"
                android:elevation="5dp"
                android:text="."
                android:textColor="#3C096C"
                android:textSize="29sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEqual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#06D6A0"
                android:elevation="7dp"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="31sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>